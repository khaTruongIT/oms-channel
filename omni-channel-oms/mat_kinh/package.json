{
  "name": "optiqis-platform",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @optiqis/api --filter @optiqis/web dev",
    "dev:web": "pnpm --filter @optiqis/web dev",
    "dev:api": "pnpm --filter @optiqis/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @optiqis/api db:generate",
    "db:migrate": "pnpm --filter @optiqis/api db:migrate",
    "db:seed": "pnpm --filter @optiqis/api db:seed"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.10.7",
    "prettier": "^3.4.2",
    "typescript": "^5.8.3",
    "vitest": "^2.1.8"
  }
}
