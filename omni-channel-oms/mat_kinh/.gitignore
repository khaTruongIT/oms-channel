# ==========================================
# Optiqis Platform Monorepo .gitignore
# Stack: pnpm workspace, Next.js 15, NestJS, Prisma, Tailwind, Playwright, Vitest
# ==========================================

# ------------------------------------------
# 1. Environment & Secrets (SECURITY CRITICAL)
# ------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
.env.override
.env*.local
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# Explicitly allow example env files
!.env.example
!.env*.example

# ------------------------------------------
# 2. Dependencies & Package Managers
# ------------------------------------------
node_modules/
.pnpm-store/
.npm/
.yarn/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# ------------------------------------------
# 3. Build & Compiler Artifacts
# ------------------------------------------
dist/
build/
out/
.next/
.turbo/
*.tsbuildinfo
apps/*/dist/
apps/*/.next/
packages/*/dist/
packages/*/build/
packages/*/out/

# ------------------------------------------
# 4. Database & ORM (Prisma)
# ------------------------------------------
apps/api/generated/
*.db
*.sqlite
*.sqlite3
*.db-journal

# ------------------------------------------
# 5. Testing & Code Coverage
# ------------------------------------------
coverage/
test-results/
playwright-report/
blob-report/
.nyc_output/
.vitest/
*.lcov

# ------------------------------------------
# 6. Operating System & System Files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ------------------------------------------
# 7. IDE, Editors & Tooling
# ------------------------------------------
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# ------------------------------------------
# 8. Temporary & Archives / Design Assets Dumps
# ------------------------------------------
# Stitch editorial prototypes / design dumps
stitch_editorial_eyewear_brand_e_commerce/
stitch_editorial_eyewear_brand_e_commerce.zip
stitch_editorial*/
stitch_editorial*.zip
stitch_edit*/
stitch_edit*.zip

*.zip
*.tar.gz
*.tgz
*.rar
*.7z
tmp/
temp/
scratch/
.cache/
.eslintcache
