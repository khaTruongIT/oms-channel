generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String           @id
  slug        String           @unique
  name        String
  line        String
  summary     String
  needs       String[]
  indexes     String[]
  coatings    String[]
  technologies String[]
  heroImage   String
  specsJson   Json
  isFeatured  Boolean          @default(false)
  articleLinks ArticleProduct[]

  @@index([slug])
  @@index([line])
}

model MedicalExpert {
  id               String    @id
  name             String
  title            String
  credential       String
  bio              String
  authoredArticles Article[] @relation("ArticleAuthor")
  reviewedArticles Article[] @relation("ArticleReviewer")
}

model Article {
  id             String           @id
  slug           String           @unique
  title          String
  excerpt        String
  contentJson    Json
  category       String
  tags           String[]
  status         ArticleStatus
  seoTitle       String
  seoDescription String
  seoScore       Int
  authorId       String
  reviewerId     String
  publishedAt    DateTime?
  scheduledAt    DateTime?
  author         MedicalExpert   @relation("ArticleAuthor", fields: [authorId], references: [id])
  reviewer       MedicalExpert   @relation("ArticleReviewer", fields: [reviewerId], references: [id])
  relatedProducts ArticleProduct[]

  @@index([slug])
  @@index([status])
  @@index([category])
}

model ArticleProduct {
  articleId String
  productId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([articleId, productId])
}

model Clinic {
  id       String   @id
  name     String
  province String
  district String
  address  String
  hotline  String
  hours    String
  lat      Float
  lng      Float
  services String[]

  @@index([province, district])
}

model ConsultationLead {
  id            String     @id @default(uuid())
  fullName      String
  phone         String
  email         String?
  province      String?
  district      String?
  productId     String?
  productName   String?
  clinicId      String?
  preferredTime String?
  note          String?
  source        LeadSource @default(HOME)
  status        LeadStatus @default(NEW)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([status, createdAt])
  @@index([phone])
  @@index([productId])
  @@index([clinicId])
}

enum ArticleStatus {
  DRAFT
  PENDING_MEDICAL_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
}

enum UserRole {
  ADMIN
  EDITOR
  MEDICAL_REVIEWER
}

enum LeadSource {
  HOME
  PRODUCT_DETAIL
  CLINIC_LOCATOR
}

enum LeadStatus {
  NEW
  CONTACTED
  BOOKED
  CLOSED
  SPAM
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(EDITOR)
  title        String?
  degree       String?
  experience   String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
}
