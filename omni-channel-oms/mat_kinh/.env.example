DATABASE_URL="postgresql://optiqis:optiqis@localhost:5432/optiqis?schema=public"
API_PORT=4000
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
WEB_ORIGIN="http://localhost:3000"

# JWT secret for signing admin tokens — CHANGE THIS IN PRODUCTION!
JWT_SECRET="optiqis-demo-secret-change-in-production"

# Optional OMS integration. Keep credentials server-side; never expose these to the browser.
OMS_SYNC_ENABLED=false
OMS_API_BASE_URL="http://localhost:4000/api/v1"
OMS_SERVICE_EMAIL="service@optiqis.vn"
OMS_SERVICE_PASSWORD="change-me"
OMS_TENANT_ID="00000000-0000-0000-0000-000000000000"
OMS_REQUEST_TIMEOUT_MS=5000
