# Database Configuration
DB_HOST=localhost
DB_PORT=5432
POSTGRES_USER=oms_user
POSTGRES_PASSWORD=oms_password
POSTGRES_DB=oms_production

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=oms_user
RABBITMQ_PASSWORD=oms_password

# Application
NODE_ENV=development
PORT=4000

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# Stock Sync Configuration
STOCK_SYNC_INTERVAL_MINUTES=5
STOCK_SYNC_MAX_RETRIES=3

# Marketplace Mock Configuration
MOCK_API_DELAY_MS=500
MOCK_WEBHOOK_ENABLED=true
