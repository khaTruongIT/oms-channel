# Database Configuration
POSTGRES_USER=oms_user
POSTGRES_PASSWORD=oms_password
POSTGRES_DB=oms_production
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PORT=6379

# RabbitMQ Configuration
RABBITMQ_USER=oms_user
RABBITMQ_PASSWORD=oms_password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Backend Configuration
NODE_ENV=development
BACKEND_PORT=4000
DATABASE_URL=postgresql://oms_user:oms_password@localhost:5432/oms_production
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://oms_user:oms_password@localhost:5672

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# Frontend Configuration
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Prisma Configuration
DATABASE_URL=postgresql://oms_user:oms_password@localhost:5432/oms_production

# BullMQ Configuration
BULL_BOARD_ENABLED=true

# Stock Sync Configuration
STOCK_SYNC_INTERVAL_MINUTES=5
STOCK_SYNC_MAX_RETRIES=3

# Marketplace Mock Configuration
MOCK_API_DELAY_MS=500
MOCK_WEBHOOK_ENABLED=true
